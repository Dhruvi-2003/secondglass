# No values are required for the local real-listing snapshot.
PORT=8086
BIND_ADDRESS=127.0.0.1
DEMO_MODE=false
LIVE_DATA_PATH=../catalogue/live.json
FRESH_HOURS=24

# Leave empty to disable owner import and diagnostics endpoints.
ADMIN_TOKEN=

# Optional OpenAI-compatible provider. Never put credentials in frontend code.
# Verify your chosen provider's current pricing/free allowance separately.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
AI_DAILY_LIMIT=20

# Optional PostgreSQL. Default is local H2 file storage.
# DATABASE_URL=jdbc:postgresql://localhost:5432/secondglass
# DATABASE_USER=secondglass
# DATABASE_PASSWORD=replace-with-a-local-password
